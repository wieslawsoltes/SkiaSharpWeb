    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <SkiaVersion Condition="'$(SkiaVersion)' == ''">3.119.0</SkiaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="$(SkiaVersion)" />
  </ItemGroup>
</Project>
